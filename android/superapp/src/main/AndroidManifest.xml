<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: MIT -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Guards the single sign-on service. protectionLevel="signature": the system grants it only to
      apps signed with this app's certificate. Every family app declares it too, so whichever app is
      installed first defines it with the same level (custom permission takeover, see
      sso-contract/FamilySsoContract.kt).
    -->
    <permission
        android:name="org.badmosip.nativesso.permission.FAMILY_SSO"
        android:label="@string/permission_label"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.badmosip.nativesso.permission.FAMILY_SSO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets Hub find a browser that supports Custom Tabs (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!--
      Tokens never leave the device: no Auto Backup, no cloud backup or device transfer, and the
      encrypted store lives in noBackupFilesDir. Cleartext HTTP: none, except to localhost in debug
      builds (src/debug/res/xml/network_security_config.xml) for the local eSignet stack.
    -->
    <application
        android:name=".HubApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives the authorization response from the browser. -->
        <activity
            android:name=".RedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:path="/callback"
                    android:scheme="org.badmosip.nativesso.superapp" />
            </intent-filter>
        </activity>

        <!--
          Family single sign-on (IFamilySso). Exported, but bindable only by apps holding the
          signature permission; every call also checks the caller's certificate and package
          (sso/FamilySsoGate.kt), because a permission alone can be taken over.
        -->
        <service
            android:name=".sso.FamilySsoService"
            android:exported="true"
            android:permission="org.badmosip.nativesso.permission.FAMILY_SSO">
            <intent-filter>
                <action android:name="org.badmosip.nativesso.action.FAMILY_SSO" />
            </intent-filter>
        </service>
    </application>
</manifest>
