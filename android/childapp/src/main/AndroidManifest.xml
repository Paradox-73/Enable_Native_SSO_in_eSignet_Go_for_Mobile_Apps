<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: MIT -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Same declaration as in the Super App, so install order does not matter. -->
    <permission
        android:name="org.badmosip.nativesso.permission.FAMILY_SSO"
        android:label="@string/permission_label"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.badmosip.nativesso.permission.FAMILY_SSO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 11+ package visibility: lets this app see, bind to and open the Super App, and find a
      browser that supports Custom Tabs for the consent login.
    -->
    <queries>
        <package android:name="org.badmosip.nativesso.superapp" />
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!--
      Tokens never leave the device: no Auto Backup, no cloud backup or device transfer, and the
      encrypted store lives in noBackupFilesDir. Cleartext HTTP: none, except to localhost in debug
      builds (src/debug/res/xml/network_security_config.xml) for the local eSignet stack.
    -->
    <application
        android:name=".CardApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives the authorization response of the consent login from the browser. -->
        <activity
            android:name=".RedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:path="/callback"
                    android:scheme="org.badmosip.nativesso.childapp" />
            </intent-filter>
        </activity>
    </application>
</manifest>
