#
# Demo settings of the local stack on top of the shipped esignet-service/data/deployment.yaml, which
# keeps Native SSO off: Native SSO on, device_sso and the token-exchange grant allowed, userinfo of
# every grant signed again, and the Health Card resource server. deploy/esignet.Dockerfile applies it
# with `git apply`; a change to the shipped file that breaks it fails the image build.

--- a/esignet/esignet-service/data/deployment.yaml
+++ b/esignet/esignet-service/data/deployment.yaml
@@ -135,13 +135,13 @@
   allowed_subject_types: ["pairwise"]
   # Native SSO also needs "urn:ietf:params:oauth:grant-type:token-exchange" here (RFC 8693) and in
   # the client's grantTypes.
-  allowed_grant_types: ["authorization_code"]
+  allowed_grant_types: ["authorization_code", "urn:ietf:params:oauth:grant-type:token-exchange"]
   allowed_response_types: ["code"]
   allowed_auth_methods: ["private_key_jwt"]
   # Native SSO also needs "device_sso" here (Native SSO 3.1). A client may request it only when its
   # additional_config.allowed_authorization_scopes lists it; never add it to scope_claims below,
   # whose keys become every client's allowed scopes.
-  allowed_scopes: ["openid","profile","email","phone"]
+  allowed_scopes: ["openid","profile","email","phone","device_sso"]
   allowed_claims: ["name","address","gender","birthdate","picture","email","phone_number"]
   default_scope_claims_mapping: 
     openid: ["sub"]
@@ -172,7 +172,8 @@
     consent_ticket_ttl_seconds: 300             # lifetime of a consent_uri, at most 600
     # Text the consent page shows for a scope (env: MOSIP_ESIGNET_NATIVE_SSO_CONSENT_SCOPE_DESCRIPTIONS,
     # a JSON object). A scope with no entry is shown by its raw value.
-    consent_scope_descriptions: {}
+    consent_scope_descriptions:
+      health_card_share: Share your health card with clinics
 
 # Device secrets of OpenID Connect Native SSO, read by the device secret provider. Env overrides:
 # MOSIP_ESIGNET_NATIVE_SSO_ENABLED, MOSIP_ESIGNET_NATIVE_SSO_DEVICE_SECRET_VALIDITY_SECONDS,
@@ -180,14 +181,14 @@
 # Native SSO is off (opt-in). Both keys live under OIDC_SERVICE; the signing key
 # must differ from jwt.preferred_key_id (start-up fails otherwise).
 native_sso:
-  enabled: false                         # false or absent: device_sso refused, as upstream eSignet
+  enabled: true                          # false or absent: device_sso refused, as upstream eSignet
   device_secret_validity_seconds: 28800  # device secret, session record and cached claims
   encryption_key_ref_id: DEVICE_SECRET    # RSA-OAEP-256 JWE key, created on first start
   signing_key_ref_id: EC_SECP256R1_SIGN   # ES256 key of the inner JWS
   # Also sign userinfo of every other grant again with eSignet's key (for an identity system that
   # signs RS256 while /oauth2/jwks publishes its key as PS256). Off: only token-exchange userinfo
   # is changed, and every other login gets the engine's answer as is.
-  resign_all_userinfo: false
+  resign_all_userinfo: true
 
 security_config:
   issuer_url: ""  # override via MOSIP_ESIGNET_SECURITY_ISSUER_URL
@@ -262,3 +263,9 @@
     default: true
     scopes:
       mosip_identity_vc_ldp: "Issue a Verifiable Credential"
+  # Permission of the Health Card demo app (Native SSO consent-only re-consent): it releases no
+  # user claim, so the user approves it without logging in again.
+  - id: health-card
+    identifier: "${MOSIP_ESIGNET_HOST}/health-card"
+    scopes:
+      health_card_share: "Show your health card to a clinic"
